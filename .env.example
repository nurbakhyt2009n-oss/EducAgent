# Скопируй в .env и заполни. Файл .env в git не попадает.

# Ключ нужен, только если в config/settings.yaml стоит provider: anthropic.
# С provider: ollama (по умолчанию) ничего вписывать не нужно.
# Ключ Anthropic API: https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# Необязательно: другие пути к данным и настройкам
# EDUCA_DATA_DIR=D:/educa-data
# EDUCA_CONFIG_DIR=./config
# EDUCA_LOG_LEVEL=INFO
